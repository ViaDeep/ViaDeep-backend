# Copia este archivo como .env en la RAÍZ del repositorio del backend (no dentro de deploy/).
# deploy/primer-arranque.sh lo crea por ti y genera las claves.

# Dirección del servidor, sin https:// (la que da Azure al elegir el nombre DNS de la IP pública).
DOMAIN=viadeep-tesis.eastus.cloudapp.azure.com

# Administrador municipal inicial (contraseña de 8 caracteres o más).
OPERATOR_EMAIL=admin@munidemo.test
OPERATOR_PASSWORD=cambia-esta-clave
OPERATOR_NAME=Administrador municipal

# Gmail del proyecto para los códigos de verificación (contraseña de aplicación de 16 letras).
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Clave de CARTO para el mapa de la web (opcional; sin ella se usa OpenStreetMap).
# En carto.com, agrega el dominio de DOMAIN a los sitios permitidos de la clave.
VITE_CARTO_API_KEY=

# Secretos: los genera primer-arranque.sh. No los compartas.
VIADEEP_JWT_PRIVATE_KEY=
NOTIFICATIONS_INTERNAL_TOKEN=
